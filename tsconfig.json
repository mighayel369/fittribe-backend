{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "config": [
        "./src/config.ts"
      ],
      "infrastructure": [
        "./src/infrastructure/index.ts"
      ],
      "infrastructure/*": [
        "./src/infrastructure/*"
      ],
      "application": [
        "./src/application/index.ts"
      ],
      "application/*": [
        "./src/application/*"
      ],
      "domain": [
        "./src/domain/index.ts"
      ],
      "domain/*": [
        "./src/domain/*"
      ],
      "presentation": [
        "./src/presentation/index.ts"
      ],
      "presentation/*": [
        "./src/presentation/*"
      ],
      "logger": [
        "./src/logger/index.ts"
      ],
      "logger/*": [
        "./src/logger/*"
      ],
      "utils": [
        "./src/utils/index.ts"
      ],
      "utils/*": [
        "./src/utils/*"
      ],
      "*": [
        "./src/*"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/@types"
    ],
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}